<?xml version="1.0" encoding="utf-8"?>
<!--
   Android Auto Backup (Google account backup + device-to-device transfer).
   Training database and settings are included, so a new phone restores the history.
   Downloaded update APKs live in the cache directory, which is never backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
